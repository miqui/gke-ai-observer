        <mxCell id="title" value="gke-ai-observer: OpenLIT AI observability on GKE (dev-ai-1). Port-forward only, GitOps (Argo CD), GCP resources via Crossplane (Upbound provider)" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1560" height="30" as="geometry"/></mxCell>
        <mxCell id="laptop" value="Operator laptop&lt;br&gt;gcloud / kubectl&lt;br&gt;./gke-port-forward.sh -&gt; 127.0.0.1&lt;br&gt;OpenLIT :3000 | Argo CD :8081&lt;br&gt;Headlamp :4466 | Polaris :8082" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="200" height="110" as="geometry"/></mxCell>
